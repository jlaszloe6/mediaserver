SHELL=/bin/bash
PATH=/usr/local/bin:/opt/calibre:/usr/bin:/bin

# Ebook pipeline: watch-folder scan, completion check, convert+import, email - every 5 min
*/5 * * * * ebookjob /scripts/ebook-pipeline.sh >> /var/log/cron/ebook-pipeline.log 2>&1

# Cap /var/log/cron/*.log files before they grow unbounded (daily 4am)
0 4 * * * ebookjob /scripts/log-rotate.sh >> /var/log/cron/log-rotate.log 2>&1
