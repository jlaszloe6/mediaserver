# Jellyfin deletion cleanup - every 30 min
*/30 * * * * /scripts/jellyfin-cleanup.sh >> /var/log/cron/jellyfin-cleanup.log 2>&1

# Queue cleanup - every 30 min
*/30 * * * * /scripts/queue-cleanup.sh >> /var/log/cron/queue-cleanup.log 2>&1

# Jellyfin watched cleanup - remove media watched 30+ days ago (daily 3am)
0 3 * * * /scripts/jellyfin-watched-cleanup.sh >> /var/log/cron/jellyfin-watched-cleanup.log 2>&1

# GeoIP database update (weekly Sunday 2am)
0 2 * * 0 /scripts/geodb-update.sh >> /var/log/cron/geodb-update.log 2>&1

# Jellyfin library scan - every 1 min (covers manual additions outside Sonarr/Radarr)
# Was slowed to every 5 min while media lived on NFS: an overlapping scan
# colliding with concurrent playback subtitle extraction/transcoding could
# stress the NAS into minutes-long stalls (see "Jellyfin Library Scan
# Stalls" in CLAUDE.md). That constraint was specific to NAS capacity -
# since the SSD migration, media reads no longer compete for NAS bandwidth,
# so the 1-minute cadence is safe again.
*/1 * * * * /scripts/jellyfin-scan.sh >> /var/log/cron/jellyfin-scan.log 2>&1

# Pipeline health monitor - every 30 min
*/30 * * * * /scripts/pipeline-monitor.sh >> /var/log/cron/pipeline-monitor.log 2>&1

# Subtitle sync check - resync existing subtitles after Sonarr/Radarr
# imports a new/upgraded video file (every 30 min)
*/30 * * * * /scripts/subtitle-sync-check.sh >> /var/log/cron/subtitle-sync-check.log 2>&1

# Subtitle pre-extract - force embedded-subtitle extraction right after
# Sonarr/Radarr imports a video, instead of leaving it to happen on demand
# at playback time (see "Jellyfin Library Scan Stalls" in CLAUDE.md for the
# NFS-era rationale). Every 1 min to match jellyfin-scan.sh's cadence,
# since an item can't be found here until Jellyfin's own scan has indexed it.
*/1 * * * * /scripts/subtitle-preextract.sh >> /var/log/cron/subtitle-preextract.log 2>&1

# Config backup to NAS (daily 2:30am)
30 2 * * * /scripts/backup.sh >> /var/log/cron/backup.log 2>&1

# Cap /var/log/cron/*.log files before they grow unbounded (daily 4am)
0 4 * * * /scripts/log-rotate.sh >> /var/log/cron/log-rotate.log 2>&1
