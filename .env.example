# Server network
SERVER_IP=192.168.1.10
LAN_SUBNET=192.168.1.0/24

# Installation display name (used in emails, status page, etc.)
SERVER_NAME=My Media Server

# Media storage mount point (local SSD - the sole storage for media and
# downloads; NFS/NAS is not used by this stack for media, but may still be
# used for backups - see BACKUP_HOST_DIR below)
MEDIA_ROOT=/mnt/mediaserver-ssd

# Container user (match the mediaserver system user UID/GID)
PUID=1000
PGID=1000

# Backup settings
# BACKUP_HOST_DIR: host-side absolute path where encrypted config backups
# are written. Deliberately independent of MEDIA_ROOT - backups need to
# survive the loss of primary media storage (e.g. the local SSD dying), so
# this should point at separate durable storage such as an NFS/NAS mount
# (e.g. /mnt/mediaserver/backups if ENABLE_NFS=true in server-setup.sh).
# On a host with no NAS available, point this at some other off-device
# location; there is no safe default that fits every host, so it must be
# set explicitly.
BACKUP_HOST_DIR=/mnt/mediaserver/backups
# BACKUP_DIR (the in-container path backup.sh/restore.sh/reboot-test.sh
# actually read) is intentionally NOT set here - docker-compose.yml's cron
# service sets it explicitly to the fixed in-container mount point that
# BACKUP_HOST_DIR above is bound to, and the host-side scripts fall back to
# BACKUP_HOST_DIR directly. A single shared value here can't be correct for
# both the in-container and host-side path.
BACKUP_RETENTION_DAYS=14
# Required: backups contain .env, API keys, SMTP creds, and SSH keys — backup.sh
# refuses to run without this set. Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# API keys (init-setup.sh reads these from each service's own config.xml
# automatically - but since it runs inside the cron container where this
# file is mounted read-only, it can't write them back here itself. It
# prints the actual values it found in a warning if they're missing from
# this file; copy them in by hand, or use scripts/env-set.sh from the host)
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=

# Seerr (API key from config/overseerr/settings.json → main.apiKey)
SEERR_API_KEY=

# Bazarr (API key from config/bazarr/config/config.yaml → auth.apikey)
BAZARR_API_KEY=

# Lidarr (API key from config/lidarr/config.xml → Config/ApiKey, or Settings → General in the UI)
LIDARR_API_KEY=

# Audiobookshelf (create via Settings → Users → API Keys in the UI, or POST /api/api-keys with isActive:true)
AUDIOBOOKSHELF_API_KEY=

# Jellyfin
JELLYFIN_API_KEY=
JELLYFIN_EXTERNAL_URL=https://${CADDY_DOMAIN_JELLYFIN}

# Email notifications (Brevo SMTP)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SEERR_SENDER_NAME=Media Server

# Transmission speed limits (KB/s)
TRANSMISSION_DOWNLOAD_LIMIT_ENABLED=false
TRANSMISSION_DOWNLOAD_LIMIT=0
TRANSMISSION_UPLOAD_LIMIT_ENABLED=true
TRANSMISSION_UPLOAD_LIMIT=50

# Status page
STATUSPAGE_SECRET_KEY=
STATUSPAGE_ALLOWED_EMAILS=user@example.com
STATUSPAGE_BASE_URL=https://mystatus.duckdns.org
# Admin email for guest management (defaults to first STATUSPAGE_ALLOWED_EMAILS entry)
ADMIN_EMAIL=

# Cloudflare Turnstile (captcha for login)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Login fails closed (rejects) if the two keys above are unset, unless you
# explicitly opt out here — e.g. for local dev without Cloudflare credentials.
REQUIRE_TURNSTILE=true

# MaxMind GeoLite2 (for GeoIP country filtering in Caddy)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# DuckDNS (for remote access via Caddy)
DUCKDNS_TOKEN=your_duckdns_token
DUCKDNS_SUBDOMAINS=your_duckdns_subdomains
CADDY_DOMAIN_JELLYFIN=myjellyfin.duckdns.org
CADDY_DOMAIN_SEERR=myseerr.duckdns.org
CADDY_DOMAIN_STATUS=mystatus.duckdns.org
CADDY_DOMAIN_NAVIDROME=mynavidrome.duckdns.org
CADDY_DOMAIN_AUDIOBOOKSHELF=myaudiobookshelf.duckdns.org
